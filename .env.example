# --- App ---
APP_NAME=sso-dispatcher
APP_ENV=dev
API_V1_PREFIX=/api/v1

# --- Database (psycopg3: mismo driver sync/async, wheels Windows/Linux) ---
DATABASE_URL=postgresql+psycopg://sso:sso@db:5432/sso
SYNC_DATABASE_URL=postgresql+psycopg://sso:sso@db:5432/sso
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
POSTGRES_DB=sso

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT (HS256 aprobado) ---
JWT_SECRET=change-me-in-env
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Password hashing (argon2) ---
# Sin parámetros aquí; argon2 usa defaults seguros.

# --- Webhooks dispatcher (aprobado) ---
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=2
WEBHOOK_HMAC_HEADER=X-Signature

# --- Seed M2M (solo dev, sin hardcodear en código) ---
# SEED_CLIENT_ID=dev-worker
# SEED_CLIENT_SECRET=cambiar-en-local-no-commitear
# SEED_CLIENT_SCOPES=webhooks:publish
